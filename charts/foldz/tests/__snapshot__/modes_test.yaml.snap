                failureThreshold: 2
                httpGet:
                  path: /readyz
                  port: ops
                periodSeconds: 2
              resources:
                limits:
                  cpu: "2"
                  memory: 512Mi
                requests:
                  cpu: "2"
                  memory: 512Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
              startupProbe:
                failureThreshold: 30
                httpGet:
                  path: /healthz
                  port: ops
                periodSeconds: 2
              volumeMounts:
                - mountPath: /etc/foldz
                  name: config
                  readOnly: true
                - mountPath: /tmp
                  name: tmp
                - mountPath: /mxl/a
                  name: mxl-0
            - args:
                - --http-address=0.0.0.0:4180
                - --upstream=http://127.0.0.1:8080/
                - --provider=oidc
                - --oidc-issuer-url=https://login.example.org/realms/media
                - --email-domain=*
