        app.kubernetes.io/name: foldz
        app.kubernetes.io/version: 1.2.3
        helm.sh/chart: foldz-1.2.3
      name: r-foldz
    spec:
      ingressClassName: nginx
      rules:
        - host: foldz.example.org
          http:
            paths:
              - backend:
                  service:
                    name: r-foldz
                    port:
                      number: 8080
                path: /
                pathType: Prefix
      tls:
        - hosts:
            - foldz.example.org
          secretName: foldz-example-org
