          labels:
            app.kubernetes.io/component: audio
            app.kubernetes.io/instance: r
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: foldz
            app.kubernetes.io/version: 1.2.3
            helm.sh/chart: foldz-1.2.3
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - --config
                - /etc/foldz/config.json
              env:
                - name: SAMPLEZ_CPU_REQUEST_MILLICORES
                  valueFrom:
                    resourceFieldRef:
                      containerName: foldz
                      divisor: 1m
                      resource: requests.cpu
                - name: SAMPLEZ_CPU_LIMIT_MILLICORES
                  valueFrom:
                    resourceFieldRef:
                      containerName: foldz
                      divisor: 1m
                      resource: limits.cpu
              image: ghcr.io/danielclasen/foldz:1.2.3
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 3
                httpGet:
                  path: /healthz
                  port: ops
                periodSeconds: 5
              name: foldz
              ports:
                - containerPort: 8080
                  name: api
                  protocol: TCP
                - containerPort: 8081
                  name: nmos
                  protocol: TCP
                - containerPort: 9090
                  name: ops
                  protocol: TCP
              readinessProbe:
                failureThreshold: 2
                httpGet:
                  path: /readyz
                  port: ops
                periodSeconds: 2
              resources:
                limits:
                  cpu: "2"
                  memory: 512Mi
                requests:
                  cpu: "2"
                  memory: 512Mi
              securityContext:
                allowPrivilegeEscalation: true
                capabilities:
                  add:
                    - SYS_NICE
                    - IPC_LOCK
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
              startupProbe:
                failureThreshold: 30
                httpGet:
                  path: /healthz
                  port: ops
                periodSeconds: 2
              volumeMounts:
                - mountPath: /etc/foldz
                  name: config
                  readOnly: true
                - mountPath: /tmp
                  name: tmp
                - mountPath: /mxl/a
                  name: mxl-0
          enableServiceLinks: false
          securityContext:
            fsGroup: 65532
            runAsGroup: 65532
            runAsNonRoot: true
            runAsUser: 65532
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: r-foldz
          terminationGracePeriodSeconds: 30
          volumes:
            - configMap:
                name: r-foldz
              name: config
            - emptyDir: {}
              name: tmp
            - hostPath:
                path: /dev/shm/mxl/a
                type: Directory
              name: mxl-0
      updateStrategy:
        type: RollingUpdate
renders plain HTTP behind a TLS-terminating ingress with token auth:
  1: |
    apiVersion: v1
    data:
      config.json: |
        {
          "api": {
            "allowedHosts": [
              "r-foldz",
              "r-foldz.audio",
              "r-foldz.audio.svc",
              "r-foldz.audio.svc.cluster.local",
              "foldz.example.org"
            ],
            "allowedOrigins": [
              "https://foldz.example.org"
            ]
          },
          "auth": {
            "mode": "token",
            "token": {
              "file": "/var/run/secrets/foldz/token/token"
            }
          },
          "domains": [
            {
              "name": "a",
              "path": "/mxl/a"
            }
          ],
          "engine": {
            "blockSize": 48,
            "readerMarginSamples": 576,
            "sampleRate": 48000
          },
          "inputs": [
            {
              "channels": 8,
              "flow": "7a1e4c9b-3d2f-4b6a-8e0c-5f7d9b1a3c55",
              "layout": [
                "L",
                "R",
                "C",
                "LFE",
                "Ls",
                "Rs",
                "-",
                "-"
              ],
              "name": "main"
            }
          ],
          "listeners": {
            "api": {
              "bind": "0.0.0.0",
              "port": 8080
            },
            "nmos": {
              "bind": "0.0.0.0",
              "port": 8081
            },
            "ops": {
              "bind": "0.0.0.0",
              "port": 9090
            }
          },
          "mxl": {
            "libraryPath": "/opt/mxl/lib/libmxl.so"
          },
          "nmos": {
            "enabled": false
          },
          "outputs": [
            {
              "flows": [
                "0f3a6c2e-5b1d-4e8a-9c7f-2d4b6a8e0c11"
              ],
              "gainDb": 0,
              "label": "Programme stereo",
              "layout": [
                "L",
                "R"
              ],
              "lfe": "drop",
              "name": "stereo",
              "preset": "bs775-3_2-to-2_0"
            }
          ],
          "rt": {
            "enabled": true,
            "priority": 70,
            "rtCpu": "auto"
          }
        }
    kind: ConfigMap
    metadata:
