          securityContext:
            fsGroup: 65532
            runAsGroup: 65532
            runAsNonRoot: true
            runAsUser: 65532
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: r-foldz
          terminationGracePeriodSeconds: 30
          volumes:
            - configMap:
                name: r-foldz
              name: config
            - emptyDir: {}
              name: tmp
            - csi:
                driver: mxl.example.org
                volumeAttributes:
                  domain: a
              name: mxl-0
      updateStrategy:
        type: RollingUpdate
