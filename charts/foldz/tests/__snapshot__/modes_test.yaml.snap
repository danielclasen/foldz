        app.kubernetes.io/component: audio
        app.kubernetes.io/instance: r
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: foldz
        app.kubernetes.io/version: 1.2.3
        helm.sh/chart: foldz-1.2.3
      name: r-foldz
    spec:
      podManagementPolicy: Parallel
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: audio
          app.kubernetes.io/instance: r
          app.kubernetes.io/name: foldz
      serviceName: r-foldz-headless
      template:
        metadata:
          annotations:
            checksum/config: fccc0e1ae74e2cf9a7e8d5c4ed8ea9feb193aab21bae54cf7636c6f93184fa73
          labels:
            app.kubernetes.io/component: audio
            app.kubernetes.io/instance: r
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: foldz
            app.kubernetes.io/version: 1.2.3
            helm.sh/chart: foldz-1.2.3
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - --config
                - /etc/foldz/config.json
              env:
                - name: SAMPLEZ_CPU_REQUEST_MILLICORES
                  valueFrom:
                    resourceFieldRef:
                      containerName: foldz
                      divisor: 1m
                      resource: requests.cpu
                - name: SAMPLEZ_CPU_LIMIT_MILLICORES
                  valueFrom:
                    resourceFieldRef:
                      containerName: foldz
                      divisor: 1m
                      resource: limits.cpu
              image: ghcr.io/danielclasen/foldz:1.2.3
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 3
                httpGet:
                  path: /healthz
                  port: ops
                periodSeconds: 5
              name: foldz
              ports:
                - containerPort: 8080
                  name: api
                  protocol: TCP
                - containerPort: 8081
                  name: nmos
                  protocol: TCP
                - containerPort: 9090
                  name: ops
                  protocol: TCP
